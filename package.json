{
  "name": "zhihu-story-promo-studio",
  "version": "1.1.0",
  "private": true,
  "description": "A privacy-aware studio for turning authorized Zhihu stories into reviewed promo copy, comics, story cards, and export-ready assets.",
  "scripts": {
    "start": "node server.mjs",
    "test": "node tests/run-tests.mjs",
    "test:external": "node tests/smoke.mjs",
    "configure:mac": "bash scripts/configure-api.sh",
    "start:mac": "bash scripts/start-all.sh",
    "start:mac:no-bgm": "bash scripts/start-all.sh --no-bgm",
    "stop:mac": "bash scripts/stop-all.sh"
  },
  "engines": {
    "node": ">=20"
  }
}
